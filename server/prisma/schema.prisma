datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CustomerTier {
  id                 String           @id @default(uuid())
  code               String           @unique
  name               String
  maxOverallDiscount Float
  minMarginThreshold Float
  isActive           Boolean          @default(true)
  customers          Customer[]
  policies           DiscountPolicy[]
}

model Customer {
  id        String             @id @default(uuid())
  name      String
  tierId    String
  tier      CustomerTier       @relation(fields: [tierId], references: [id])
  currency  String             @default("INR")
  status    String             @default("ACTIVE")
  quotes    Quote[]
  users     User[]
  negotiations QuoteNegotiation[]
}

model ProductCategory {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  maxCategoryDiscount Float
  products            Product[]
  policies            DiscountPolicy[]
}

model Product {
  id               String            @id @default(uuid())
  sku              String            @unique
  name             String
  categoryId       String
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  costPrice        Float
  sellingPrice     Float
  isActive         Boolean           @default(true)
  quoteLines       QuoteLine[]
  triggerRules     CrossSellRule[]   @relation("TriggerProduct")
  recommendedRules CrossSellRule[]   @relation("RecommendedProduct")
  inventoryStocks  InventoryStock[]
  fulfillmentItems FulfillmentItem[]
}

model User {
  id                    String             @id @default(uuid())
  name                  String
  email                 String             @unique
  passwordHash          String             @default("")
  role                  String
  customerId            String?
  customer              Customer?          @relation(fields: [customerId], references: [id])
  quotesCreated         Quote[]            @relation("QuotesCreated")
  approvalAssigned      ApprovalRequest[]  @relation("AssignedApprover")
  approvalActioned      ApprovalRequest[]  @relation("ActionedBy")
  negotiationsSubmitted QuoteNegotiation[] @relation("NegotiationsSubmitted")
}

model DiscountPolicy {
  id                 String           @id @default(uuid())
  name               String
  tierId             String?
  tier               CustomerTier?    @relation(fields: [tierId], references: [id])
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  maxDiscountPercent Float
  riskSeverity       String           @default("HIGH")
  requiresApproval   Boolean          @default(true)
}

model ApprovalRule {
  id                  String  @id @default(uuid())
  name                String
  minRiskLevel        String
  requiredRole        String
  autoApproveEligible Boolean @default(false)
}

model Quote {
  id                   String            @id @default(uuid())
  quoteNumber          String            @unique
  customerId           String
  customer             Customer          @relation(fields: [customerId], references: [id])
  salesRepId           String
  salesRep             User              @relation("QuotesCreated", fields: [salesRepId], references: [id])
  status               String
  grossRevenue         Float
  discountAmount       Float
  netRevenue           Float
  estimatedCost        Float
  grossMargin          Float
  marginPercentage     Float
  riskLevel            String
  riskScore            Float
  riskReasonsJson      String
  requiredApproverRole String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lines                QuoteLine[]
  approvalRequests     ApprovalRequest[]
  fulfillmentPlan      FulfillmentPlan?
  negotiations         QuoteNegotiation[]
}

model QuoteLine {
  id               String                 @id @default(uuid())
  quoteId          String
  quote            Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                @relation(fields: [productId], references: [id])
  quantity         Int
  unitPrice        Float
  unitCost         Float
  discountPercent  Float
  discountAmount   Float
  subtotal         Float
  netTotal         Float
  lineCost         Float
  lineMargin       Float
  fulfillmentItems FulfillmentItem[]
  negotiationLines QuoteNegotiationLine[]
}

model QuoteNegotiation {
  id                   String                 @id @default(uuid())
  quoteId              String
  quote                Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customerId           String
  customer             Customer               @relation(fields: [customerId], references: [id])
  submittedByUserId    String
  submittedByUser      User                   @relation("NegotiationsSubmitted", fields: [submittedByUserId], references: [id])
  round                Int                    @default(1)
  status               String                 // 'SUBMITTED' | 'APPROVED' | 'REJECTED'
  customerNote         String?
  managerReason        String?                // Internal manager notes ONLY
  customerResponseNote String?                // Customer-safe response note
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  lines                QuoteNegotiationLine[]
}

model QuoteNegotiationLine {
  id                String           @id @default(uuid())
  negotiationId     String
  negotiation       QuoteNegotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  quoteLineId       String
  quoteLine         QuoteLine        @relation(fields: [quoteLineId], references: [id])
  requestedDiscount Float
  customerNote      String?
}

model ApprovalRequest {
  id                 String    @id @default(uuid())
  quoteId            String
  quote              Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status             String
  requiredRole       String
  assignedApproverId String?
  assignedApprover   User?     @relation("AssignedApprover", fields: [assignedApproverId], references: [id])
  actionedById       String?
  actionedBy         User?     @relation("ActionedBy", fields: [actionedById], references: [id])
  actionReason       String?
  createdAt          DateTime  @default(now())
  actionedAt         DateTime?
}

model AuditEvent {
  id                String   @id @default(uuid())
  entityType        String
  entityId          String
  actorId           String
  actorName         String
  action            String
  previousStateJson String?
  newStateJson      String?
  contextJson       String?
  createdAt         DateTime @default(now())
}

model CrossSellRule {
  id                   String  @id @default(uuid())
  triggerProductId     String
  triggerProduct       Product @relation("TriggerProduct", fields: [triggerProductId], references: [id])
  recommendedProductId String
  recommendedProduct   Product @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])
  reasonTemplate       String
  minMarginPercent     Float   @default(30.0)
}

model Warehouse {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  location         String
  baseShippingCost Float             @default(500.0)
  priority         Int               @default(1)
  stocks           InventoryStock[]
  fulfillmentItems FulfillmentItem[]
}

model InventoryStock {
  id               String    @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand   Int
  quantityReserved Int       @default(0)

  @@unique([warehouseId, productId])
}

model FulfillmentPlan {
  id                   String            @id @default(uuid())
  quoteId              String            @unique
  quote                Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status               String            // 'ALLOCATED' | 'PARTIALLY_FULFILLED_BACKORDER' | 'OVERRIDDEN'
  totalShipments       Int
  totalFulfillmentCost Float
  backorderCount       Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  items                FulfillmentItem[]
}

model FulfillmentItem {
  id                String          @id @default(uuid())
  planId            String
  plan              FulfillmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  quoteLineId       String
  quoteLine         QuoteLine       @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  warehouseId       String?
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  allocatedQuantity Int
  status            String          // 'FULFILLED' | 'BACKORDERED'
  shippingCost      Float           @default(0.0)
}
